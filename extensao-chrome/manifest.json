{
  "manifest_version": 3,
  "name": "nod: trazer o login do seu Chrome",
  "short_name": "nod",
  "version": "1.0.0",
  "description": "Deixa o navegador do bot do nod entrar já logado num site, com o login que você já tem neste Chrome. Só o site que você pede, só quando você toca em Trazer do meu Chrome.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "servico.js",
    "type": "module"
  }
}
